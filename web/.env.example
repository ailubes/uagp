# Server-side only; optional read access to PUBLIC GitHub data.
# Never use NEXT_PUBLIC_ for a secret.
GITHUB_TOKEN=
# live (default) or snapshot (deterministic offline testing)
UAGP_DATA_MODE=live

# Private queue. Production requires a persistent directory outside the web root
# and a random reviewer key (32 random bytes, hex encoded). Single-host SQLite.
UAGP_QUEUE_DIR=
UAGP_REVIEW_KEY=
# Separate fine-grained token for ailubes/uagp, Issues: write, for publication only.
UAGP_QUEUE_GITHUB_TOKEN=
