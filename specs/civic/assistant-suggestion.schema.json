{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Citizen AI Assistant read-only suggestion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assistant_message",
    "clarification_questions",
    "proposed_desired_outcome",
    "proposed_solution",
    "procedure_hint",
    "evidence_questions"
  ],
  "properties": {
    "assistant_message": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1400
    },
    "clarification_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "proposed_desired_outcome": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "proposed_solution": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "procedure_hint": {
      "enum": [
        "policy_idea",
        "citizen_appeal",
        "information_request",
        "petition",
        "administrative_application",
        "other",
        null
      ]
    },
    "evidence_questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    }
  }
}
